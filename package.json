{
  "name": "casper-guard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Casper Guard — Casper-native policy, x402 signing, MCP, reconciliation, and audit backend for agentic payments.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --config vitest.casper.config.ts",
    "test:casper": "vitest run --config vitest.casper.config.ts",
    "test:full-substrate": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.casper.config.ts",
    "test:coverage": "vitest run --config vitest.casper.config.ts --coverage",
    "migrate": "tsx src/db/migrate.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@make-software/casper-x402": "^1.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@x402/core": "2.15.0",
    "casper-js-sdk": "5.0.12",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "light-my-request": "6.6.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
