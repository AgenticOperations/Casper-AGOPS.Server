{
  "name": "casper-guard-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "AgentOps — Casper-native policy, x402 signing, MCP, reconciliation, and audit backend for agentic payments.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.mjs && node scripts/copy-wasm.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --config vitest.casper.config.ts",
    "test:casper": "vitest run --config vitest.casper.config.ts",
    "test:full-substrate": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.casper.config.ts",
    "test:coverage": "vitest run --config vitest.casper.config.ts --coverage",
    "migrate": "tsx src/db/migrate.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@make-software/casper-x402": "^1.0.0",
    "@x402/core": "2.15.0",
    "casper-js-sdk": "5.0.12",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.27.0": ">=6.27.0 <7",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "vite@<6.4.3": ">=6.4.3 <9",
      "find-my-way@<9.7.0": ">=9.7.0",
      "fast-uri@<3.1.4": ">=3.1.4",
      "brace-expansion": ">=5.0.8",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "postcss@<8.5.18": ">=8.5.18"
    },
    "patchedDependencies": {
      "casper-js-sdk@5.0.12": "patches/casper-js-sdk@5.0.12.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "light-my-request": "6.6.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "testcontainers": "^10.16.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  }
}
